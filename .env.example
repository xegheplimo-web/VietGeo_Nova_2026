# VietGeo Nova — biến môi trường mẫu.
# LƯU Ý: app đọc trực tiếp os.environ, KHÔNG tự nạp file .env.
# Dùng PowerShell:  $env:VIETGEO_API_TOKEN='...' ; python -m vietgeo.server
# hoặc copy file này thành .env nếu bạn tự thêm loader / dùng cho docker compose.

# Bearer token tùy chọn cho các API ghi (POST/PUT/DELETE). Để trống = không bắt token.
VIETGEO_API_TOKEN=

# Đường dẫn file SQLite (mặc định: data/vietgeo.sqlite3)
# VIETGEO_DB=data/vietgeo.sqlite3

# Tự đồng bộ 3.321 xã/phường lần chạy đầu: "1" bật (mặc định), "0" tắt
# VIETGEO_AUTO_ADMIN_SYNC=1

# Chỉ dùng trong Docker: cho phép bind 0.0.0.0. KHÔNG bật khi chạy trực tiếp Windows.
# VIETGEO_CONTAINER=0
